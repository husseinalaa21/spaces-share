// Shared.xcconfig — build settings common to every SpaceShare configuration.
// Debug.xcconfig and Release.xcconfig include this file.

// xcconfig treats "//" as a comment, so URLs are written as https:/$(SLASH)host.
SLASH = /

// Identity
PRODUCT_BUNDLE_IDENTIFIER = com.spacechatllc.spaceshare
INFOPLIST_KEY_CFBundleDisplayName = SpaceShare
DEVELOPMENT_TEAM = SVDD93966K

// Version (MARKETING_VERSION is what users see, CURRENT_PROJECT_VERSION is the build number)
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// Deployment targets
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0

// Spacechat API the app talks to. Override per configuration or in Local.xcconfig.
SPACES_API_BASE_URL = https:/$(SLASH)www.spacechat.app
SPACES_ENVIRONMENT = production

// Merged into the generated Info.plist so the app can read the values above at runtime.
INFOPLIST_FILE = Config/Info-Extra.plist
